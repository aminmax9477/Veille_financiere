# Cle FRED - gratuite sur https://fredaccount.stlouisfed.org/apikeys
# Indispensable pour toute la couverture macro et taux americains.
FRED_API_KEY=

# Cle London Strategic Edge - https://londonstrategicedge.com/data
# Seule source cablee couvrant le CAC 40, l'Euro Stoxx 50 en quotidien et
# l'or, et qui publie l'inflation zone euro plusieurs mois avant Eurostat.
LSE_API_KEY=

# Contact transmis a la SEC dans le User-Agent. La SEC exige un contact
# identifiable pour l'acces a EDGAR; sans lui les appels peuvent etre bloques.
VF_SEC_CONTACT=prenom.nom@example.com

# Duree de vie du cache HTTP, en secondes (0 pour desactiver).
VF_CACHE_TTL=3600

# Seuil de divergence relative par defaut entre deux sources (0.005 = 0,5 %).
VF_RECONCILE_TOLERANCE=0.005
